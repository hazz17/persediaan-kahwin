rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Satu bilik = satu dokumen. Hanya sesiapa yang tahu kod 8 aksara boleh baca/tulis.
    // Senarai semua bilik dan padam bilik tidak dibenarkan.
    match /rooms/{room} {
      allow get, create, update: if request.auth != null
        && room.matches('^[A-HJ-KM-NP-Z2-9]{8}$');
      allow list, delete: if false;
    }
  }
}
